                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dtos.RequestChangePassword"
                        }
                    }
                ],
                "responses": {}
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Login user by name",
