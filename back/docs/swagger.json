                "earned_stars": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "lesson_name": {
                    "type": "string"
                },
                "log_at": {
                    "type": "string"
                },
                "profile_id": {
                    "type": "integer"
                },
                "result": {
                    "type": "string"
                }
            }
        },
        "models.Profile": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "integer"
                },
                "activities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Activity"
                    }
                },
                "birth_year": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "stars": {
                    "type": "integer"
                }
            }
        },
        "types.ActivityDto": {
            "type": "object",
            "properties": {
                "earned_stars": {
                    "type": "integer"
                },
                "lesson_name": {
                    "type": "string"
                },
                "result": {
                    "type": "string"
                }
            }
        },
        "types.CommonResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
